{
    "version": 1,
    "opaqueDrawBuffers": [
        0,
        1,
        2
    ],
    "translucentDrawBuffers": [
        0
    ],
    "excludeLodsFromVanillaDepth": true,
    "useViewportDims": true,
    "blending": {
        "-1": "SRC_ALPHA ONE_MINUS_SRC_ALPHA ONE ONE_MINUS_SRC_ALPHA"
    },
    "taaOffset": "{ const vec2 halton[8] = vec2[8](vec2(0.5, 0.3333333), vec2(0.25, 0.6666667), vec2(0.75, 0.1111111), vec2(0.125, 0.4444444), vec2(0.625, 0.7777778), vec2(0.375, 0.2222222), vec2(0.875, 0.5555556), vec2(0.0625, 0.8888889)); return (halton[frameCounter % 8] - 0.5) * 2.0 / vec2(viewWidth, viewHeight); }",
    "uniforms": [
        "frameCounter",
        "viewWidth",
        "viewHeight",
        "rainStrength",
        "skyColor",
        "fogColor",
        "sunPosition",
        "shadowLightPosition",
        "gbufferModelViewInverse",
        "gbufferProjectionInverse"
    ],
    "samplers": []
}
